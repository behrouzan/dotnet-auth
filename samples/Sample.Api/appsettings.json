{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=sample-auth.db"
  },
  "TokenAuthentication": {
    "Issuer": "Sample.Api",
    "Audience": "Sample.Api.Client",
    "Algorithm": "HS256",
    "AccessTokenLifetime": "00:15:00",
    "RefreshTokenLifetime": "30.00:00:00"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
